<%- include('partials/header') %>
<div class="card" style="max-width:480px">
  <h1>Cambio password</h1>
  <p class="sub">Scegli una password personale di almeno 8 caratteri.</p>
  <form method="post" action="/password">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row"><div><label>Password attuale</label><input type="password" name="vecchia" required></div></div>
    <div class="row"><div><label>Nuova password</label><input type="password" name="nuova" minlength="8" required></div></div>
    <div class="row"><div><label>Conferma nuova password</label><input type="password" name="conferma" minlength="8" required></div></div>
    <button>Salva</button>
  </form>
</div>
<%- include('partials/footer') %>
