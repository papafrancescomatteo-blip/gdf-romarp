<%- include('partials/header') %>
<div class="login card">
  <span class="logo">GdF</span>
  <h1>Portale Guardia di Finanza</h1>
  <p class="sub">Comando Provinciale · Roma RP. Accesso riservato al personale.</p>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row"><div><label>Username</label><input name="username" autocomplete="username" required autofocus></div></div>
    <div class="row"><div><label>Password</label><input type="password" name="password" autocomplete="current-password" required></div></div>
    <button>Accedi</button>
  </form>
</div>
<%- include('partials/footer') %>
