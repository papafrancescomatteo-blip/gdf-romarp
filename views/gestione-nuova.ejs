<%- include('partials/header') %>
<h1>Nuova gestione settimanale</h1>
<p class="sub">Per ogni finanziere scegli l'esito; le righe senza esito non vengono incluse.</p>
<form method="post" action="/gestioni">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="card">
    <div class="row">
      <div style="max-width:220px"><label>Lunedì della settimana</label><input type="date" name="settimana" required></div>
      <div><label>Titolo / note generali (facoltativo)</label><input name="etichetta"></div>
    </div>
  </div>
  <div class="card scroll">
    <table>
      <thead><tr><th>Finanziere</th><th>Ore</th><th>Esito</th><th>Note</th></tr></thead>
      <tbody>
      <% finanzieri.forEach(function(u){ %>
        <tr>
          <td><%= u.grado ? u.grado.nome + ' ' : '' %><%= u.cognome %> <%= u.nome %><br><small class="muted"><%= u.matricola || '' %></small></td>
          <td><input type="number" min="0" step="0.5" name="voci[<%= u._id %>][ore]" value="0" style="width:80px"></td>
          <td><select name="voci[<%= u._id %>][esito]">
            <option value="">—</option>
            <% ESITI.forEach(function(e){ %><option><%= e %></option><% }) %>
          </select></td>
          <td><input name="voci[<%= u._id %>][note]" maxlength="500" style="width:100%;min-width:180px"></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <% if (!finanzieri.length) { %><p class="muted">Non ci sono finanzieri attivi. Creali dalla sezione Utenti.</p><% } %>
  </div>
  <button>Salva gestione</button> <a class="btn sec" href="/gestioni">Annulla</a>
</form>
<%- include('partials/footer') %>
