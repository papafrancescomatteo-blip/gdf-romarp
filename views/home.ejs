<%- include('partials/header') %>
<h1>Benvenuto, <%= me.grado ? me.grado.nome + ' ' : '' %><%= nomeCompleto(me) %></h1>
<p class="sub"><%= me.ruolo === 'finanziere' ? 'Area Finanzieri' : (me.ruolo === 'ufficiale' ? 'Area Ufficiali' : 'Area Prefettura') %></p>

<% if (me.ruolo === 'finanziere') { %>
<div class="grid">
  <div class="card">
    <h2>La mia matricola</h2>
    <div class="grado big-grado">
      <% if (me.grado && me.grado.immagine) { %><img src="<%= me.grado.immagine %>" alt="<%= me.grado.nome %>"><% } %>
      <div><strong><%= me.grado ? me.grado.nome : 'Grado non assegnato' %></strong><br><span class="muted">Matricola: <%= me.matricola || '—' %></span></div>
    </div>
  </div>

  <div class="card">
    <h2>Avvertimenti e sospensioni attivi</h2>
    <% if (!provvedimenti.length) { %><p class="muted">Nessun provvedimento attivo.</p><% } %>
    <% provvedimenti.forEach(function(p){ %>
      <p><span class="tag <%= p.tipo %>"><%= p.categoria %></span> <%= p.motivo %><br><small class="muted"><%= d(p.createdAt) %><%= p.dataScadenza ? ' · fino al ' + d(p.dataScadenza) : '' %></small></p>
    <% }) %>
    <a href="/provvedimenti">Storico completo →</a>
  </div>
</div>

<div class="card">
  <h2>Le mie ultime gestioni settimanali</h2>
  <% if (!gestioni.length) { %><p class="muted">Nessuna gestione ancora registrata.</p><% } else { %>
  <div class="scroll"><table>
    <thead><tr><th>Settimana</th><th>Ore</th><th>Esito</th><th>Note</th></tr></thead>
    <tbody>
    <% gestioni.forEach(function(g){ %>
      <tr><td>Settimana del <%= d(g.settimana) %></td><td><%= g.voce.ore %></td><td><span class="tag"><%= g.voce.esito %></span></td><td><%= g.voce.note || '' %></td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>

<div class="grid">
  <div class="card">
    <h2>Direttive operative</h2>
    <% if (!direttive.length) { %><p class="muted">Nessuna direttiva pubblicata.</p><% } %>
    <% direttive.forEach(function(l){ %>
      <div class="link-item"><div><a href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.titolo %></a><br><small class="muted"><%= l.descrizione %></small></div></div>
    <% }) %>
  </div>
  <div class="card">
    <h2>Supervisione allievi</h2>
    <% if (supervisioneUrl) { %>
      <p>Compila il modulo per inviare la supervisione degli allievi.</p>
      <a class="btn" href="<%= supervisioneUrl %>" target="_blank" rel="noopener noreferrer">Invia supervisione</a>
    <% } else { %><p class="muted">Il modulo non è ancora stato configurato dagli ufficiali.</p><% } %>
  </div>
</div>

<% } else if (me.ruolo === 'ufficiale') { %>
<div class="stats">
  <div class="stat"><b><%= nFinanzieri %></b><span>Finanzieri attivi</span></div>
  <div class="stat"><b><%= nProvvAttivi %></b><span>Provvedimenti attivi</span></div>
  <div class="stat"><b><%= ultimaGestione ? d(ultimaGestione.settimana) : '—' %></b><span>Ultima gestione (settimana del)</span></div>
</div>
<div class="grid">
  <div class="card">
    <h2>Azioni rapide</h2>
    <p><a class="btn" href="/gestioni/nuova">Nuova gestione settimanale</a></p>
    <p><a class="btn sec" href="/provvedimenti">Applica provvedimento</a></p>
    <p><a class="btn sec" href="/matricole">Foglio matricole</a></p>
  </div>
  <div class="card">
    <h2>Da controllare</h2>
    <% if (mancanti && mancanti.length) { %>
      <p><strong>Senza gestione nell'ultima settimana registrata:</strong></p>
      <p><%= mancanti.map(function(u){ return nomeCompleto(u); }).join(', ') %></p>
    <% } else { %><p class="muted">Nessun finanziere in sospeso nell'ultima gestione.</p><% } %>
    <% if (scadute.length) { %>
      <p><strong>Provvedimenti scaduti ancora attivi:</strong></p>
      <% scadute.forEach(function(p){ %><p><span class="tag <%= p.tipo %>"><%= p.categoria %></span> <%= nomeCompleto(p.utente) %> · scaduto il <%= d(p.dataScadenza) %></p><% }) %>
      <a href="/provvedimenti">Vai ai provvedimenti →</a>
    <% } %>
  </div>
</div>
<div class="card">
  <h2>Ultime attività</h2>
  <% if (!logs.length) { %><p class="muted">Nessuna attività.</p><% } %>
  <% logs.forEach(function(l){ %><p><small class="muted"><%= dt(l.createdAt) %></small> · <%= nomeCompleto(l.autore) %>: <%= l.descrizione %></p><% }) %>
  <a href="/logs">Registro completo →</a>
</div>

<% } else { %>
<div class="stats">
  <div class="stat"><b><%= nFinanzieri %></b><span>Finanzieri in organico</span></div>
</div>
<div class="grid">
  <div class="card"><h2>Consultazione</h2>
    <p><a class="btn" href="/direttive">Linee guida e direttive</a></p>
    <p><a class="btn sec" href="/gestioni">Ultime 3 gestioni settimanali</a></p>
    <p><a class="btn sec" href="/matricole">Foglio matricole</a></p>
  </div>
  <div class="card"><h2>Ultime gestioni</h2>
    <% if (!gestioni.length) { %><p class="muted">Nessuna gestione registrata.</p><% } %>
    <% gestioni.forEach(function(g){ %><p>Settimana del <strong><%= d(g.settimana) %></strong> · <%= g.voci.length %> finanzieri</p><% }) %>
  </div>
</div>
<% } %>
<%- include('partials/footer') %>
